{
  "name": "fhevm-agent-skill",
  "version": "1.0.0",
  "private": true,
  "description": "AI-native skill system and runnable examples for Zama FHEVM confidential app development.",
  "license": "MIT",
  "bin": {
    "fhevm-agent-os": "./scripts/fhevm-agent-os.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile",
    "test": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat test examples/confidential-voting/test/ConfidentialVoting.ts examples/encrypted-erc7984/test/ConfidentialToken.ts examples/confidential-payroll/test/ConfidentialPayroll.ts examples/sealed-bid-auction/test/SealedBidAuction.ts examples/confidential-dao/test/ConfidentialDAO.ts examples/confidential-marketplace/test/ConfidentialMarketplace.ts",
    "test:voting": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat test examples/confidential-voting/test/ConfidentialVoting.ts",
    "test:erc7984": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat test examples/encrypted-erc7984/test/ConfidentialToken.ts",
    "test:payroll": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat test examples/confidential-payroll/test/ConfidentialPayroll.ts",
    "test:auction": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat test examples/sealed-bid-auction/test/SealedBidAuction.ts",
    "test:dao": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat test examples/confidential-dao/test/ConfidentialDAO.ts",
    "test:marketplace": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat test examples/confidential-marketplace/test/ConfidentialMarketplace.ts",
    "agent:smoke": "node scripts/agent-smoke-test.mjs",
    "os:doctor": "node scripts/fhevm-agent-os.mjs doctor",
    "os:recipes": "node scripts/fhevm-agent-os.mjs list-recipes",
    "os:scaffold": "node scripts/fhevm-agent-os.mjs scaffold",
    "deploy:contract:voting": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat run scripts/deploy-confidential-voting.ts --network sepolia",
    "deploy:frontend:voting": "node scripts/deploy-voting-frontend.mjs",
    "deploy:demo": "node scripts/deploy-full-demo.mjs",
    "clean": "rimraf artifacts cache types fhevmTemp"
  },
  "dependencies": {
    "@fhevm/mock-utils": "0.4.2",
    "@fhevm/solidity": "0.11.1",
    "@openzeppelin/confidential-contracts": "0.4.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "encrypted-types": "0.0.4"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.30",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "hardhat-deploy": "^0.11.45",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  }
}
