{
  "name": "fhevm",
  "version": "1.0.0",
  "description": "Plugin-style skills for Zama FHEVM confidential app development.",
  "skillsDirectory": "skills",
  "skills": [
    "skills/use-fhevm",
    "skills/build-fhevm-contracts",
    "skills/integrate-fhevm-frontend",
    "skills/test-fhevm-contracts",
    "skills/deploy-fhevm-dapp",
    "skills/use-erc7984",
    "skills/scaffold-fhevm-dapp"
  ],
  "pluginMetadata": {
    "codex": ".codex-plugin/plugin.json",
    "claude": ".claude-plugin/plugin.json",
    "cursor": ".cursor-plugin/plugin.json",
    "mcp": ".mcp.json"
  },
  "agentAdapters": {
    "codex": "AGENTS.md",
    "claudeCodeMemory": "CLAUDE.md",
    "cursor": ".cursor/rules/fhevm-agent-skill.mdc",
    "windsurf": ".windsurf/rules/fhevm-agent-skill.md",
    "cline": ".clinerules/fhevm-agent-skill.md",
    "githubCopilot": ".github/copilot-instructions.md"
  },
  "assets": {
    "examples": "assets/examples",
    "templates": "assets/templates",
    "logo": "assets/logo.svg",
    "logoSquare": "assets/logo-square.svg"
  },
  "validation": {
    "smoke": "npm run agent:smoke",
    "doctor": "npm run os:doctor",
    "compile": "npm run compile",
    "test": "npm test"
  },
  "runtime": {
    "cli": "scripts/fhevm-agent-os.mjs",
    "commands": [
      "doctor",
      "list-recipes",
      "install-adapters",
      "scaffold"
    ]
  }
}
